# Variables de entorno del backend (configúralas en Railway → Variables)

# Ruta del archivo SQLite. En Railway apúntala al Volume montado en /data
DB_PATH=/data/turnos.db

# Dominio del frontend autorizado a llamar la API (Vercel).
# Déjalo sin definir para permitir cualquier origen (*).
CORS_ORIGIN=https://tu-app.vercel.app

# PIN compartido para el equipo. Si lo defines, la app pedirá este PIN para entrar.
# Déjalo sin definir (o vacío) para que la app quede abierta, sin PIN.
APP_PIN=1234

# PORT lo asigna Railway automáticamente; no hace falta definirlo.
